{
  "id": "./",
  "name": "NexusTS",
  "short_name": "NexusTS",
  "version": "0.9.3",
  "description": "Offline-capable Remote Desktop (RDP), SSH, SFTP, VNC & Zero-Knowledge .nxts Connection Manager for ChromeOS.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f8fafc",
  "theme_color": "#ffffff",
  "categories": ["productivity", "utilities", "developer tools"],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Neue Verbindung",
      "short_name": "Verbindung",
      "description": "Neue RDP-, SSH-, SFTP- oder VNC-Verbindung anlegen",
      "url": "./?action=new-connection",
      "icons": [
        {
          "src": "./icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Schnellverbindung",
      "short_name": "Schnellstart",
      "description": "Direkt per Ad-hoc-Adresse verbinden (ssh://, rdp://, vnc://)",
      "url": "./?action=quick-connect",
      "icons": [
        {
          "src": "./icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Google Drive Sync",
      "short_name": "Drive Sync",
      "description": "Google Drive .nxts Tresor-Synchronisierung öffnen",
      "url": "./?action=drive-sync",
      "icons": [
        {
          "src": "./icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Einstellungen",
      "short_name": "Einstellungen",
      "description": "NexusTS Einstellungen & Anmeldedaten öffnen",
      "url": "./?action=settings",
      "icons": [
        {
          "src": "./icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./?source=file-handler",
      "accept": {
        "application/octet-stream": [".nxts", ".rtsz", ".1pux"],
        "application/xml": [".rtsx", ".xml"]
      }
    }
  ]
}
